---
export function getStaticPaths() {
  const redirects = {
    'tuinmeubelsbeschermers': '/beste-tuinmeubelbeschermers/',
    'sfeerverlichting-buiten': '/beste-sfeerverlichting-buiten/',
    'staandeplantenbakken': '/beste-staandeplantenbakken/',
    'windmolen-voor-thuis': '/beste-windmolen-voor-thuis/',
    'tuinwanddecoratie': '/beste-tuinwanddecoratie/',
    'plantenbakhouder': '/beste-plantenbakhouder/',
    'hangingbaskets': '/beste-hangingbaskets/',
    'plantenmanden': '/beste-plantenmanden/',
    'plantenschalen': '/beste-plantenschalen/',
    'plantenbakken': '/beste-plantenbakken/',
  };
  return Object.entries(redirects).map(([slug, target]) => ({
    params: { slug },
    props: { target },
  }));
}

const { target } = Astro.props;
return Astro.redirect(target, 301);
---
