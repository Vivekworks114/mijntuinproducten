---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryPage from '../../components/CategoryPage.astro';
import { navigation } from '../../data/navigation';

const section = navigation.find((item) => item.href === '/decoratie/');
const items = section?.children ?? [];
---

<BaseLayout title="Decoratie - Mijn Tuin Producten" description="Bekijk de beste tuindecoratie en maak je tuin nog mooier.">
  <CategoryPage
    title="Decoratie"
    description="Maak je tuin nog mooier met de beste tuindecoratie. Van plantenbakken tot sfeerverlichting."
    items={items}
  />
</BaseLayout>
