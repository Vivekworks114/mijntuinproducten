---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryPage from '../../components/CategoryPage.astro';
import { navigation } from '../../data/navigation';

const section = navigation.find((item) => item.href === '/tuingerei/');
const items = section?.children ?? [];
---

<BaseLayout title="Tuingerei - Mijn Tuin Producten" description="Handig tuingereedschap en accessoires.">
  <CategoryPage
    title="Tuingerei"
    description="Praktisch tuingereedschap en accessoires voor een verzorgde tuin."
    items={items}
  />
</BaseLayout>
