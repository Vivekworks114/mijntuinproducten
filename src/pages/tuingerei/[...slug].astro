---
export function getStaticPaths() {
  const redirects = {
    'buitenmat': '/beste-buitenmat/',
    'elektrische-barbecue': '/beste-elektrische-barbecue/',
    'flexibele-tuinslang': '/beste-flexibele-tuinslang/',
    'hogedrukreiniger': '/beste-hogedrukreiniger/',
    'houten-tuinkast': '/beste-houten-tuinkast/',
    'opbergbox-tuinkussens': '/beste-opbergbox-tuinkussens/',
    'parasolhoes': '/beste-parasolhoes/',
    'tuinhuisje-met-overkapping': '/beste-tuinhuisje-met-overkapping/',
    'tuinmeubelbeschermers': '/beste-tuinmeubelbeschermers/',
    'tuinstoel': '/beste-tuinstoel/',
  };
  return Object.entries(redirects).map(([slug, target]) => ({
    params: { slug },
    props: { target },
  }));
}

const { target } = Astro.props;
return Astro.redirect(target, 301);
---
