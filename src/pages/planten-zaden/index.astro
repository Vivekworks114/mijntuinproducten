---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryPage from '../../components/CategoryPage.astro';
import { navigation } from '../../data/navigation';

const section = navigation.find((item) => item.href === '/planten-zaden/');
const items = section?.children ?? [];
---

<BaseLayout title="Planten & zaden - Mijn Tuin Producten" description="Planten, zaden en bemesting voor je tuin.">
  <CategoryPage
    title="Planten & zaden"
    description="Alles voor het zaaien en kweken: zaden, plantenbescherming en bemesting."
    items={items}
  />
</BaseLayout>
