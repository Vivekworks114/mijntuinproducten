---
export function getStaticPaths() {
  const redirects = {
    'plantenbescherming': '/beste-plantbescherming/',
    'zaai-pootgoed': '/beste-zaai-pootgoed/',
    'kamerplanten': '/beste-kamerplanten/',
    'vijverplanten': '/beste-vijverplanten/',
    'tuinplanten': '/beste-tuinplanten/',
    'kruidenzaden': '/beste-kruidenzaden/',
    'groentezaden': '/beste-groentezaden/',
    'bloemzaden': '/beste-bloemzaden/',
    'graszaden': '/beste-graszaden/',
    'bemesting': '/beste-bemesting/',
  };
  return Object.entries(redirects).map(([slug, target]) => ({
    params: { slug },
    props: { target },
  }));
}

const { target } = Astro.props;
return Astro.redirect(target, 301);
---
