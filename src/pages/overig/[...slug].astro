---
export function getStaticPaths() {
  const redirects = {
    'combisystemen-stelen': '/beste-combisysteem-stelen/',
    'vochtmeters-planten': '/beste-vochtmeters-planten/',
    'bodemverwerker': '/beste-bodemverwerker/',
    'sneeuwruimers': '/beste-sneeuwruimer/',
    'veegmachine': '/beste-veegmachine/',
    'plantenzakken': '/beste-plantenzakken/',
    'deurklopper': '/beste-deurklopper/',
    'wandlamp': '/beste-wandlamp-voor-buiten/',
    'windgong': '/beste-windgong/',
    'tuinkleding': '/beste-tuinkleding/',
  };
  return Object.entries(redirects).map(([slug, target]) => ({
    params: { slug },
    props: { target },
  }));
}

const { target } = Astro.props;
return Astro.redirect(target, 301);
---
