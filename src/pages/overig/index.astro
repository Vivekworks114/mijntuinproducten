---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryPage from '../../components/CategoryPage.astro';
import { navigation } from '../../data/navigation';

const section = navigation.find((item) => item.href === '/overig/');
const items = section?.children ?? [];
---

<BaseLayout title="Overig - Mijn Tuin Producten" description="Overige tuinproducten en accessoires.">
  <CategoryPage
    title="Overig"
    description="Ontdek overige tuinproducten en handige accessoires voor in en om je tuin."
    items={items}
  />
</BaseLayout>
