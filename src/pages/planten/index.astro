---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryPage from '../../components/CategoryPage.astro';
import { navigation } from '../../data/navigation';

const section = navigation.find((item) => item.href === '/planten/');
const items = section?.children ?? [];
---

<BaseLayout title="Planten - Mijn Tuin Producten" description="Ontdek de mooiste planten voor in en rond je huis.">
  <CategoryPage
    title="Planten"
    description="Ontdek de mooiste planten voor in en rond je huis. Van kamerplanten tot tuinplanten, wij hebben ze allemaal beoordeeld."
    items={items}
  />
</BaseLayout>
