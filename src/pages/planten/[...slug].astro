---
export function getStaticPaths() {
  const redirects = {
    'aglaonema-pictum-tricolor': '/plant/aglaonema-pictum-tricolor/',
    'alocasia-azlanii': '/plant/alocasia-azlanii/',
    'alocasia-frydek-variegata': '/plant/alocasia-frydek-variegata/',
    'calathea-medaillon': '/plant/calathea-medaillon/',
    'ficus-shivereana-moonshine': '/plant/ficus-shivereana-moonshine/',
    'honingboom': '/plant/honingboom/',
    'hoya-burtoniae': '/plant/hoya-burtoniae/',
    'hoya-sigillatis': '/plant/hoya-sigillatis/',
    'philodendron-joepii': '/plant/philodendron-joepii/',
    'sansevieria-zeylanica': '/plant/sansevieria-zeylanica/',
  };
  return Object.entries(redirects).map(([slug, target]) => ({
    params: { slug },
    props: { target },
  }));
}

const { target } = Astro.props;
return Astro.redirect(target, 301);
---
