---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryPage from '../../components/CategoryPage.astro';
import { navigation } from '../../data/navigation';

const section = navigation.find((item) => item.href === '/verbouwing/');
const items = section?.children ?? [];
---

<BaseLayout title="Verbouwing - Mijn Tuin Producten" description="Producten voor verbouwing in en om je tuin.">
  <CategoryPage
    title="Verbouwing"
    description="Van schuttingen tot tuinhuisjes — producten voor je verbouwing."
    items={items}
  />
</BaseLayout>
