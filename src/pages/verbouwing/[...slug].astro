---
export function getStaticPaths() {
  const redirects = {
    'garagedeuropener': '/beste-garagedeuropener/',
    'containerombouw': '/beste-containerombouw/',
    'schuttingdeur': '/beste-schuttingdeur/',
    'vijveronderhoud': '/beste-vijveronderhoud/',
    'schuttingpalen': '/beste-schuttingpalen/',
    'afrasteringen': '/beste-afrasteringen/',
    'tuinafdakje': '/beste-tuinafdakjes/',
    'tuinhuisje': '/beste-tuinhuisje/',
    'tuinkasten': '/beste-tuinkast/',
    'schutting': '/beste-schutting/',
  };
  return Object.entries(redirects).map(([slug, target]) => ({
    params: { slug },
    props: { target },
  }));
}

const { target } = Astro.props;
return Astro.redirect(target, 301);
---
