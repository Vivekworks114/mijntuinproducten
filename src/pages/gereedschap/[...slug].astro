---
export function getStaticPaths() {
  const redirects = {
    'tuingereedschapsetjes': '/beste-tuingereedschapsetjes/',
    'gazongereedschap': '/beste-gazongereedschap/',
    'snoeigereedschap': '/beste-snoeigereedschap/',
    'zaaggereedschap': '/beste-zaaggereedschap/',
    'hogedrukreiniger': '/beste-hogedrukreiniger/',
    'heggenschaar': '/beste-heggenschaar/',
    'tuinruimer': '/beste-tuinruimer/',
    'grasmaaier': '/beste-grasmaaier/',
    'bladblazer': '/beste-bladblazer/',
  };
  return Object.entries(redirects).map(([slug, target]) => ({
    params: { slug },
    props: { target },
  }));
}

const { target } = Astro.props;
return Astro.redirect(target, 301);
---
