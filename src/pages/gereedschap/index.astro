---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryPage from '../../components/CategoryPage.astro';
import { navigation } from '../../data/navigation';

const section = navigation.find((item) => item.href === '/gereedschap/');
const items = section?.children ?? [];
---

<BaseLayout title="Gereedschap - Mijn Tuin Producten" description="Bekijk de beste tuingereedschappen.">
  <CategoryPage
    title="Gereedschap"
    description="Vind het juiste gereedschap voor jouw tuin. Van grasmaaiers tot heggenscharen."
    items={items}
  />
</BaseLayout>
