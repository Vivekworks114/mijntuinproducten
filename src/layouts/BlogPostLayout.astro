---
import BaseLayout from './BaseLayout.astro';
import { fallbackImage } from '../data/fallback-images';

interface Props {
  entry: {
    data: {
      title: string;
      description: string;
      pubDate: Date;
      author?: string;
      categories?: string[];
      tags?: string[];
      featuredImage?: string;
    };
    id: string;
  };
}

const { entry } = Astro.props;
const { title, description, pubDate, author, categories, featuredImage } = entry.data;
const heroImage = featuredImage || fallbackImage(entry.id);

const formattedDate = pubDate.toLocaleDateString('nl-NL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} - Mijn Tuin Producten`} description={description}>
  <article class="blog-post">
    <header class="blog-post__header">
      <div class="container">
        <nav class="blog-post__breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/blog/">Blog</a>
          <span>/</span>
          <span>{title}</span>
        </nav>
        <h1 class="blog-post__title">{title}</h1>
        <div class="blog-post__meta">
          <time class="blog-post__date" datetime={pubDate.toISOString()}>{formattedDate}</time>
          {author && <span class="blog-post__author">door {author}</span>}
          {categories && categories.length > 0 && (
            <span class="blog-post__categories">
              {categories.map((cat) => (
                <span class="blog-post__category">{cat}</span>
              ))}
            </span>
          )}
        </div>
      </div>
    </header>

    <div class="blog-post__featured">
      <div class="container">
        <img src={heroImage} alt={title} class="blog-post__image" loading="eager" />
      </div>
    </div>

    <div class="blog-post__body">
      <div class="container">
        <div class="blog-post__content">
          <slot />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .blog-post__header {
    background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
    padding: 3rem 0 2.5rem;
  }

  .blog-post__breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .blog-post__breadcrumb a {
    color: rgba(255, 255, 255, 0.7);
    transition: color var(--transition-fast);
  }

  .blog-post__breadcrumb a:hover {
    color: var(--color-white);
  }

  .blog-post__title {
    color: var(--color-white);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    margin-bottom: 1rem;
    max-width: 800px;
  }

  .blog-post__meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .blog-post__author {
    font-style: italic;
  }

  .blog-post__category {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    background: rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
  }

  .blog-post__featured {
    padding: 2rem 0;
    background: var(--color-bg-light);
  }

  .blog-post__image {
    width: 100%;
    max-width: 800px;
    height: auto;
    aspect-ratio: 16/9;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .blog-post__body {
    padding: 3rem 0 4rem;
  }

  .blog-post__content {
    max-width: 750px;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .blog-post__content :global(h2) {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    margin: 2.5rem 0 1rem;
    color: var(--color-primary);
  }

  .blog-post__content :global(h3) {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    margin: 2rem 0 0.75rem;
    color: var(--color-primary-dark);
  }

  .blog-post__content :global(p) {
    margin-bottom: 1.25rem;
    color: var(--color-text-light);
  }

  .blog-post__content :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--transition-fast);
  }

  .blog-post__content :global(a:hover) {
    color: var(--color-secondary);
  }

  .blog-post__content :global(ul),
  .blog-post__content :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .blog-post__content :global(li) {
    margin-bottom: 0.5rem;
    color: var(--color-text-light);
  }

  .blog-post__content :global(ul li) {
    list-style: disc;
  }

  .blog-post__content :global(ol li) {
    list-style: decimal;
  }

  .blog-post__content :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    margin: 1.5rem 0;
  }

  .blog-post__content :global(blockquote) {
    border-left: 4px solid var(--color-primary);
    padding-left: 1rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--color-text-light);
  }

  .blog-post__content :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }
</style>
